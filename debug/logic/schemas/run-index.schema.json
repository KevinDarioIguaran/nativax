{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nativax/run-index@1.0",
  "title": "NativaX derived run-index record",
  "description": "One JSONL record in debug/artifacts/index/runs.jsonl. Derived from a validated diagnostic run manifest; regenerated by debug/logic/context.py.",
  "type": "object",
  "required": ["schema", "runId", "area", "kind", "status", "archivedAt", "path"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "nativax.run.v1"},
    "runId": {"type": "string", "minLength": 1},
    "area": {"type": "string", "minLength": 1},
    "kind": {"enum": ["benchmark", "archive"]},
    "status": {"enum": ["completed", "failed", "aborted"]},
    "engine": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "archivedAt": {"type": "string", "minLength": 10},
    "files": {"type": ["integer", "null"], "minimum": 0},
    "bytes": {"type": ["integer", "null"], "minimum": 0},
    "source": {"type": ["string", "null"]},
    "path": {"type": "string", "minLength": 1}
  }
}
