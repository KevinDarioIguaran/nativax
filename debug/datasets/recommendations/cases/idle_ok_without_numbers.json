{
  "id": "idle_ok_without_numbers",
  "description": "Idle status ok but RSS/CPU missing.",
  "grounds": [
    "R3-R5: the budget rules need measured RSS and CPU; a missing number is not 0 MB.",
    "General: missing data is reported as missing, never as a pass or a failure."
  ],
  "input": {
    "app_idle": {
      "status": "ok"
    }
  },
  "expected": [
    "memory.idle.unmeasured"
  ],
  "must_not": [
    "capability.game_player.unmeasured",
    "capability.video.no_playback",
    "leaks.cases.failing",
    "leaks.cases.inconclusive",
    "memory.idle.over_target",
    "memory.load_peak.unmeasured",
    "perf.coverage.missing_scenarios",
    "perf.dom.over_target",
    "perf.game.over_target",
    "perf.js.over_target",
    "perf.scroll.frame_p95_over_target",
    "renderer.dom_layout.cross_signal",
    "security.checks.failing",
    "visual.color.low",
    "visual.coverage.missing_pages",
    "visual.ink.missing",
    "visual.position.low"
  ],
  "expected_priorities": {}
}
