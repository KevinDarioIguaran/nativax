{
  "id": "empty_catalogs_and_rows",
  "description": "Empty catalogs, empty result lists, idle within budget.",
  "grounds": [
    "R1/R2: nothing is pending when the catalog is empty.",
    "R5: idle within budget asks for the load peak."
  ],
  "input": {
    "app_idle": {
      "status": "ok",
      "rss_tail_mb": 100,
      "cpu_tail_pct": 0.2
    },
    "visual": {
      "rows": []
    },
    "visual_catalog": [],
    "perf": {
      "results": []
    },
    "perf_catalog": [],
    "leaks": {
      "results": []
    },
    "security": {
      "results": []
    }
  },
  "expected": [
    "memory.load_peak.unmeasured"
  ],
  "must_not": [
    "capability.game_player.unmeasured",
    "capability.video.no_playback",
    "leaks.cases.failing",
    "leaks.cases.inconclusive",
    "memory.idle.over_target",
    "memory.idle.unmeasured",
    "perf.coverage.missing_scenarios",
    "perf.dom.over_target",
    "perf.game.over_target",
    "perf.js.over_target",
    "perf.scroll.frame_p95_over_target",
    "renderer.dom_layout.cross_signal",
    "security.checks.failing",
    "visual.color.low",
    "visual.coverage.missing_pages",
    "visual.ink.missing",
    "visual.position.low"
  ],
  "expected_priorities": {
    "memory.load_peak.unmeasured": "P2"
  }
}
