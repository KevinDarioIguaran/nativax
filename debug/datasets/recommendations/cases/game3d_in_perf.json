{
  "id": "game3d_in_perf",
  "description": "Slow game3d.* scenario in the perf run.",
  "grounds": [
    "R14: game3d. scenarios are game profiles too (the detail table already lists them as 3D)."
  ],
  "input": {
    "app_idle": {
      "status": "ok",
      "rss_tail_mb": 100,
      "cpu_tail_pct": 0.2
    },
    "perf": {
      "results": [
        {
          "scenario": "game3d.quality-640x360-c100",
          "kind": "dom",
          "verdict": "FAIL",
          "nativax": {
            "status": "ok",
            "scenario_ms": 100,
            "render_ms": 0,
            "frame_ms": {}
          },
          "chromium": {
            "status": "ok",
            "scenario_ms": 10,
            "render_ms": 0,
            "frame_ms": {
              "p95": 1
            }
          }
        }
      ]
    }
  },
  "expected": [
    "memory.load_peak.unmeasured",
    "perf.game.over_target"
  ],
  "must_not": [
    "capability.game_player.unmeasured",
    "capability.video.no_playback",
    "leaks.cases.failing",
    "leaks.cases.inconclusive",
    "memory.idle.over_target",
    "memory.idle.unmeasured",
    "perf.coverage.missing_scenarios",
    "perf.dom.over_target",
    "perf.js.over_target",
    "perf.scroll.frame_p95_over_target",
    "renderer.dom_layout.cross_signal",
    "security.checks.failing",
    "visual.color.low",
    "visual.coverage.missing_pages",
    "visual.ink.missing",
    "visual.position.low"
  ],
  "expected_priorities": {}
}
