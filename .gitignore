.dart_tool/
build/
.packages
pubspec.lock
*.iml
.idea/

# Generated debug artifacts, all under one root: downloaded conformance
# suites/results, visual fidelity runs, performance measurements, JSON audit
# reports and immutable per-run archives (debug/logic/storage.py).
debug/artifacts/

# Benchmark runs are generated locally, one directory per execution
# (debug/benchmarks/<area>/<run_id>/). Suites live in debug/engines.
debug/benchmarks/microbench/
debug/benchmarks/leaks/
debug/benchmarks/security/

# Python bytecode from the tooling.
__pycache__/
tools/v8-spike/
