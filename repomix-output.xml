// stack pointer when a goto leaves the scope a VLA was declared in
#if defined(M3_COMPILER_MSVC) || defined(M3_COMPILER_TCC) || defined(__STDC_NO_VLA__)
#  define M3_HAS_VLA 0
#else
#  define M3_HAS_VLA 1
#endif

