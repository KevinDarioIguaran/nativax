    0x44, 0x89, 0x94, 0x24, 0, 0, 0, 0, /* mov    %r10,<sp_offset>(%sp) */
  };
  uint8_t *addr = push_insns (insn_varr, st_pat, sizeof (st_pat));
  memcpy (addr + 4, &sp_offset, sizeof (uint32_t));
  if (b64_p) addr[0] |= 8;
