    target.extendWithPath(transformed, Offset.zero);
  }

  void _op(String name, List<Object?> a) {
    switch (name) {
      case 'reset':
        surface.image?.dispose();
        surface.image = null;
        canvas.drawPaint(Paint()..blendMode = BlendMode.clear);
        surface.state = _State();
        surface.stack.clear();
        path = Path();
      case 'save':
        surface.stack.add(st.copy());
        canvas.save();
        saves++;
      case 'restore':
