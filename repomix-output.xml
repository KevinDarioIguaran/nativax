}

/**
 * Command to spawn the player entity
 */
export interface SpawnPlayerCommand {
  position: { x: number; y: number; z: number };
}

/**
 * Batch spawn result
 */
export interface BatchSpawnResult {
  entityIds: EntityId[];
  successCount: number;
}

/**
 * Default sizes for entity types
 */
