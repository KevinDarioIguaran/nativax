/// One `MutationObserver.observe()` registration.
class _Observation {
  _Observation(this.target, this.options);
  final Node target;
  final Map<String, Object?> options;

  bool get subtree => options['subtree'] == true;
  bool get childList => options['childList'] == true;
  bool get attributes => options['attributes'] == true || options['attributeOldValue'] == true || options['attributeFilter'] != null;
  bool get characterData => options['characterData'] == true || options['characterDataOldValue'] == true;
