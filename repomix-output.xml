            s += 8;
            break;
        case c_m3Type_i64:
            *(i64*)o_retptrs[i] = *(i64*)(s);
            s += 8;
            break;
        case c_m3Type_funcref:
        case c_m3Type_externref:
        case c_m3Type_exnref:
            *(uintptr_t*)o_retptrs[i] = *(uintptr_t*)(s);
            s += 8;
            break;
#if d_m3HasFloat
        case c_m3Type_f32:
            *(f32*)o_retptrs[i] = *(f32*)(s);
            s += 8;
            break;
        case c_m3Type_f64:
            *(f64*)o_retptrs[i] = *(f64*)(s);
