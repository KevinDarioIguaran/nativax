globalThis.assert_throws_exactly = (expected, fn, m) => {
  try { fn(); } catch (e) { assert(e === expected, m || 'wrong exception'); return; }
  throw new AssertionError(`${m || 'assert_throws_exactly'}: did not throw`);
};
