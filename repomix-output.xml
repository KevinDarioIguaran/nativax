int _MIR_name_char_p (MIR_context_t ctx MIR_UNUSED, int ch, int first_p) {
  if (isalpha (ch) || ch == '_' || ch == '$' || ch == '%' || ch == '.') return TRUE;
  return !first_p && isdigit (ch);
}

