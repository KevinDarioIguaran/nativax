  ENTER();
  int32_t i = I(ctx, A(0));
  if (i > 0 && i < NX_MAX_SYNCS && nx_syncs[i]) {
    gl.DeleteSync(nx_syncs[i]);
    nx_syncs[i] = NULL;
  }
  return JS_UNDEFINED;
}

