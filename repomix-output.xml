                                border: Border.all(color: const Color(0x33000000)),
                              ),
                            ),
                          ),
                      ]),
                    ),
                  ],
                ),
              );
              if (picked == null) return;
              _userInput(element, '#${picked.toRadixString(16).padLeft(6, '0')}', commit: true);
