    0x48, 0x89, 0xec,                   /*mov    %rbp,%rsp */
    0x5d,                               /*pop    %rbp */
    0x58,                               /*pop    %rax               */
    0x48, 0x8b, 0x4c, 0x24, 0x08,       /*mov  0x08(%rsp),%rcx */
